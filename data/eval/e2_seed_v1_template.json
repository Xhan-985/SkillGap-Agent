  "usage": "模板：5 个差异化画像 + 25 个（画像, JD）对占位。3 个示例已填（含 2 个对抗用例），其余 22 个待人工标注。jd_text 从真实数据粘贴（库内 job / e1_seed_v2 / 新采集均可，优先 2026 真实 JD）。标注完成后另存为 e2_seed_v1.json（本模板保留不动）。",
  "annotation_guidelines": {
    "human_match_score_anchors": {
      "90-100": "must_have 全部达标且深度富余，nice_to_have 大多覆盖，软性条件（年限/学历）契合",
      "70-89": "核心 must_have 达标，少量 must 深度不足或 nice_to_have 缺失",
      "50-69": "must_half 过半达标，基础能力在但关键技能有缺口",
      "30-49": "仅少数 must 达标，基础与 JD 方向存在明显距离",
      "0-29": "方向完全不匹配（或画像为纯裸声明且 JD 要求工程落地能力）"
    },
    "three_groups": {
      "strong": "画像有该技能且有扎实证据（项目细节/手动确认），等级 ≥ JD 要求",
      "weak": "画像有该技能但仅裸声明、等级不足或证据薄弱（confidence < 0.5）",
      "missing": "画像完全不具备该技能（含可通过 transferable 关联但本体缺失时——仍标 missing，note 注明可迁移）"
    },
    "adversarial_checklist": [
      "技能仅裸声明（低 confidence）→ 人工分应低于有证据技能的同级画像",
      "JD 要求与画像完全无关 → 人工分应 ≤ 29",
      "别名变体 JD（如 LangChain vs LangChain.js）→ 三组判定应一致（词表归一化正确性）"
    ],
    "annotators": ["user（必标全集）", "同学A/B（抽标 ≥10 对，检验一致性）"]
  },
